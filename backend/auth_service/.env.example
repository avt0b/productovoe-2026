# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth

# JWT (HS256 — общий секрет для всех сервисов)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Bootstrap первого администратора (is_root=true) при старте сервиса
BOOTSTRAP_ROOT_EMAIL=root@marshruty.ru
BOOTSTRAP_ROOT_PASSWORD=change-me-now

# Внутренний ключ служебной плоскости /internal/* (тот же в admin_service)
INTERNAL_API_KEY=dev-internal-key-change-me

# Откуда клиентскому приложению можно входить: dev-сервер Vite и APK (Capacitor)
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost","https://localhost","capacitor://localhost"]

# --- Внешний вход: VK ID, Яндекс ID, MAX, Госуслуги ---
# Адрес этого сервиса, каким его видит браузер телефона (для APK — IP компьютера в сети)
EXTERNAL_AUTH_PUBLIC_URL=http://127.0.0.1:8001
# Тестовые провайдеры вместо настоящих — для локальной разработки. В production не работают.
EXTERNAL_AUTH_MOCK=true
EXTERNAL_AUTH_LOGIN_TTL_SECONDS=600
# Куда можно вернуть человека после входа
EXTERNAL_AUTH_RETURN_PREFIXES=["marshruty://","http://localhost:5174","http://127.0.0.1:5174","https://localhost"]

# VK ID: приложение регистрируется на id.vk.com, redirect_uri = <EXTERNAL_AUTH_PUBLIC_URL>/auth/external/vk/callback
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=

# Яндекс ID: приложение регистрируется на oauth.yandex.ru, redirect_uri = <EXTERNAL_AUTH_PUBLIC_URL>/auth/external/yandex/callback
YANDEX_ID_CLIENT_ID=
YANDEX_ID_CLIENT_SECRET=

# MAX: бот на платформе MAX (только верифицированное юрлицо), webhook = <публичный адрес>/auth/external/max/webhook
MAX_BOT_NAME=
MAX_WEBHOOK_SECRET=
