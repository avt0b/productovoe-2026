# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth

# JWT (HS256 — общий секрет для всех сервисов)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Bootstrap первого администратора (is_root=true) при старте сервиса
BOOTSTRAP_ROOT_EMAIL=root@marshruty.local
BOOTSTRAP_ROOT_PASSWORD=change-me-now
