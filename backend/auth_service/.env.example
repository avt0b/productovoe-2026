# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth

# JWT (HS256 — общий секрет для всех сервисов)
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Bootstrap первого администратора (is_root=true) при старте сервиса
BOOTSTRAP_ROOT_EMAIL=root@marshruty.ru
BOOTSTRAP_ROOT_PASSWORD=change-me-now

# Внутренний ключ служебной плоскости /internal/* (тот же в admin_service)
INTERNAL_API_KEY=dev-internal-key-change-me

# Откуда клиентскому приложению можно входить: dev-сервер Vite и APK (Capacitor)
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","https://localhost","capacitor://localhost"]
