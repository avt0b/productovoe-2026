# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth

# JWT (RS256: сервис подписывает приватным ключом, остальные проверяют публичным)
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# OAuth-провайдеры (Госуслуги / VK ID / Yandex ID)
ESIA_CLIENT_ID=
ESIA_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
