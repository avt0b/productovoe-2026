# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://marshruty:marshruty@127.0.0.1:5432/admin

# JWT админки — СВОЙ секрет, НЕ равный JWT_SECRET остальных сервисов.
ADMIN_JWT_SECRET=dev-admin-secret-change-me
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_ISSUER=admin_service
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
MFA_TOKEN_TTL_MINUTES=5

# Двухфакторная аутентификация
TOTP_ISSUER_NAME=Маршруты победы
TOTP_VALID_WINDOW=1
REQUIRE_TOTP=true
RECOVERY_CODES_COUNT=10

# Защита от перебора пароля
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Внутренний ключ служебной плоскости — тот же, что в остальных сервисах
INTERNAL_API_KEY=dev-internal-key-change-me
UPSTREAM_TIMEOUT_SECONDS=5

AUTH_SERVICE_URL=http://127.0.0.1:8001
USER_SERVICE_URL=http://127.0.0.1:8002
MAP_SERVICE_URL=http://127.0.0.1:8003
ROUTE_SERVICE_URL=http://127.0.0.1:8006
SEARCH_HQ_SERVICE_URL=http://127.0.0.1:8004
ARCHIVE_SERVICE_URL=http://127.0.0.1:8005
MEDIA_SERVICE_URL=http://127.0.0.1:8007

# Origin веб-админки (JSON-массив)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Первый суперадминистратор — создаётся на старте, TOTP настраивает сам
BOOTSTRAP_ADMIN_EMAIL=admin@marshruty.ru
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-please
