# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://marshruty:marshruty@127.0.0.1:5432/search_hq

# Тот же секрет, что в auth_service
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service

# Внутренний ключ служебной плоскости /internal/* (тот же в admin_service)
INTERNAL_API_KEY=dev-internal-key-change-me

# Достижения за выезд и донат
USER_SERVICE_URL=http://127.0.0.1:8002

# Откуда клиентскому приложению можно ходить в сервис: dev-сервер Vite и APK (Capacitor)
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","https://localhost","capacitor://localhost"]

# Экскурсии и бамп
# Радиус места сбора, м. Для демо за столом — поставьте побольше или создайте экскурсию там, где сидите.
EXCURSION_SITE_RADIUS_M=150
# Погрешность GPS, которую засчитываем сверх радиуса, м
BUMP_ACCURACY_SLACK_M=50
# Сколько идёт сбор группы, мин
GATHERING_DURATION_MINUTES=30
# На сколько секунд могут разойтись встряски краеведа и участника
BUMP_WINDOW_SECONDS=1.5
# Сколько секунд встряска ждёт пару
BUMP_WAIT_SECONDS=2.0
