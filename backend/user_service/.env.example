# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/users

# Тот же секрет, что в auth_service
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service

# Внутренний ключ служебной плоскости /internal/* (тот же в admin_service)
INTERNAL_API_KEY=dev-internal-key-change-me

# NFC-метки, выдающие роль: роль:sha256 ключа через запятую. Пусто — метки
# не работают. Строку печатает `uv run python -m scripts.make_role_keys`.
ROLE_GRANT_KEYS=

# Push-доставка (FCM HTTP v1). Не задано — push просто не уходит, лента и
# ачивки работают как обычно. Ключ сервисного аккаунта берётся из Firebase
# Console → Project settings → Service accounts → Generate new private key.
# Локально удобнее путь к файлу; в докере/CI — весь JSON одной строкой
# в FCM_CREDENTIALS_JSON (без монтирования секретного файла).
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=

# Откуда клиентскому приложению можно ходить в сервис: dev-сервер Vite и APK (Capacitor)
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost","https://localhost","capacitor://localhost"]
