# Скопируйте в .env
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/users

# Тот же секрет, что в auth_service
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service

# Внутренний ключ служебной плоскости /internal/* (тот же в admin_service)
INTERNAL_API_KEY=dev-internal-key-change-me

# Откуда клиентскому приложению можно ходить в сервис: dev-сервер Vite и APK (Capacitor)
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","https://localhost","capacitor://localhost"]
