# ==========================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ==========================================
APP_ENV=production
LOG_LEVEL=info

# ==========================================
#PostgreSQL
# ==========================================
DB_USER=user
DB_PASSWORD=пароль_для_бд
DB_HOST=postgres
DB_PORT=5432

# ==========================================
# БЕЗОПАСНОСТЬ И JWT
# ==========================================
JWT_SECRET=секретный_ключ_для_jwt
JWT_ALGORITHM=HS256
JWT_ISSUER=auth_service
INTERNAL_API_KEY=секрет_для_внутренних_запросов
# NFC-метки, выдающие роль (user_service): роль:sha256 ключа через запятую.
# Строку печатает `python -m scripts.make_role_keys` в backend/user_service.
ROLE_GRANT_KEYS=

# ==========================================
#Admin Service
# ==========================================
ADMIN_JWT_SECRET=секрет_для_админки
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_ISSUER=admin_service
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
MFA_TOKEN_TTL_MINUTES=5

TOTP_ISSUER_NAME="Маршруты победы"
TOTP_VALID_WINDOW=1
REQUIRE_TOTP=false
RECOVERY_CODES_COUNT=10
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15
UPSTREAM_TIMEOUT_SECONDS=5

BOOTSTRAP_ADMIN_EMAIL=admin@marshruty.ru
BOOTSTRAP_ADMIN_PASSWORD=пароль_для_первого_админа
BOOTSTRAP_ROOT_EMAIL=root@marshruty.ru
BOOTSTRAP_ROOT_PASSWORD=пароль_для_рута

# Сайт и админка ходят в API с того же домена (через nginx) — им CORS не нужен.
# Нужен APK: Capacitor открывает приложение с https://localhost (а на стенде с
# сервисами по http — с http://localhost), отсюда и эти origin.
CORS_ORIGINS=["https://marshrutpobedy.website","https://www.marshrutpobedy.website","https://localhost","http://localhost","capacitor://localhost"]

# Вход через VK ID / Яндекс ID / MAX / Госуслуги (auth_service). Адрес, по
# которому провайдер вернёт человека, — через nginx: /api/auth/external/...
# Куда потом можно вернуть: сайт и APK (ссылкой marshruty://).
EXTERNAL_AUTH_PUBLIC_URL=https://marshrutpobedy.website/api
EXTERNAL_AUTH_RETURN_PREFIXES=["marshruty://","https://marshrutpobedy.website"]

# ==========================================
# MINIO И NATS
# ==========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=пароль_для_minio
MINIO_ENDPOINT=http://minio:9000
# Внешний адрес того же MinIO, который откроет браузер. У сервиса minio в
# docker-compose.yml нет ports: — порт 9000 наружу не пробрасывается, только
# для контейнеров в той же сети. nginx уже проксирует /storage/ -> minio:9000
# (docker/nginx/conf.d/marshruty.conf) — поэтому здесь домен + /storage, а не
# порт напрямую. Не задать вообще (как было) — сервисы откатятся на
# MINIO_ENDPOINT и будут отдавать ссылки вида http://minio:9000/..., которые
# не резолвятся нигде, кроме docker-сети.
MINIO_PUBLIC_BASE_URL=https://marshrutpobedy.website/storage
NATS_URL=nats://nats:4222

# ==========================================
# Сбор на экскурсии (search_hq_service)
# ==========================================
# В каком радиусе от точки экскурсии краевед открывает сбор и засчитывается
# встряска телефонов, в метрах. По умолчанию в сервисе 150 м — этого мало:
# сбор назначают «у школы», а группа стоит у автобуса через квартал, и в поле
# сам GPS врёт на десятки метров. Запас на погрешность (BUMP_ACCURACY_SLACK_M,
# 50 м) идёт сверх этого радиуса.
EXCURSION_SITE_RADIUS_M=500

# ==========================================
# Платежи (search_hq_service, донаты отрядам)
# ==========================================
# Оба пустые — донаты работают как раньше, без шлюза (сразу зачисляются в БД).
# Заданы — включается реальный поток через ЮKassa (тестовый или боевой магазин):
# pending → редирект на оплату → вебхук → succeeded.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://marshruty.ru/payments/return

# ==========================================
# Живое фото (media_service + media_render_worker)
# ==========================================
# Общий секрет между media_service и media_render_worker — воркер стучится
# в /render/* этим токеном, не пользовательским JWT.
RENDER_WORKER_TOKEN=секрет_для_воркера_рендера
# Yandex SpeechKit (синтез речи) — где взять, см. backend/media_render_worker/README.md.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Ranvik (говорящий портрет, Kling Avatar 2.0) — агрегатор с оплатой в рублях
# (api.ranvik.ru: Ranvik ID → пополнить баланс → API-ключи), см.
# backend/media_render_worker/README.md.
RANVIK_API_KEY=
# true — проверить «Живое фото» целиком без трат: вместо запроса в Ranvik
# воркер кладёт в MinIO заглушку «DRY RUN». В бою — false.
RANVIK_DRY_RUN=false
