# Скопируйте в .env.local

# Адреса публичных сервисов (порты — backend/README.md).
# Для APK на телефоне укажите адрес компьютера в локальной сети, например
# http://192.168.1.10:8003: 127.0.0.1 на телефоне — это сам телефон.
VITE_MAP_API_URL=http://127.0.0.1:8003
VITE_ROUTE_API_URL=http://127.0.0.1:8006

# Подложка карты. По умолчанию — стандартные тайлы OpenStreetMap.
# Топографическая альтернатива с горизонталями — OpenTopoMap:
# VITE_MAP_TILES_URL=https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
# VITE_MAP_TILES_ATTRIBUTION=&copy; участники OpenStreetMap, SRTM &copy; OpenTopoMap (CC-BY-SA)
