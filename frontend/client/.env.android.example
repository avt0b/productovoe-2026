# Скопируйте в .env.android.local — из него `npm run android:sync` собирает APK.
#
# Боевой сервер: всё через nginx на домене, по https. Префиксы — из
# docker/nginx/conf.d/marshruty.conf (hq ходит в /api/search, auth — в /api:
# auth_service сам держит префикс /auth).
#
# Для стенда в локальной сети — адреса компьютера по http, например
# http://192.168.1.10:8001 … :8007 (см. .env.example). Тогда APK сам откроется
# с http://localhost (capacitor.config.ts), иначе WebView заблокирует фото.
VITE_AUTH_API_URL=https://marshrutpobedy.website/api
VITE_USER_API_URL=https://marshrutpobedy.website/api/users
VITE_MAP_API_URL=https://marshrutpobedy.website/api/map
VITE_HQ_API_URL=https://marshrutpobedy.website/api/search
VITE_ARCHIVE_API_URL=https://marshrutpobedy.website/api/archive
VITE_ROUTE_API_URL=https://marshrutpobedy.website/api/routes
VITE_MEDIA_API_URL=https://marshrutpobedy.website/api/media

# Кнопка «Поделиться» в APK отдаёт ссылку на сайт.
VITE_PUBLIC_WEB_URL=https://marshrutpobedy.website
